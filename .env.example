EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# RevenueCat — Project settings → API keys → App-specific (appl_ / goog_)
# Sin estas, compras.ts funciona en modo mock (simula la compra).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob — unidades de anuncio de la consola de AdMob.
# Sin estas se usan las de test de Google (no dan ingresos).
EXPO_PUBLIC_ADMOB_BANNER=
EXPO_PUBLIC_ADMOB_INTERSTICIAL=

# Supabase — servidor de salas. Project Settings → API Keys → "Publishable key"
# (NO la "Secret key" — esa nunca va en el cliente). Sin estas, entrarConCodigo()
# no encuentra servidor y avisa que hace falta jugar en un solo celular.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
